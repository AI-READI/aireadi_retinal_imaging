   "source": [
    "import os, csv\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "import pydicom\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "ROOT = r\"F:\\raw\\newb\"\n",
    "OUT_CSV = r\"F:\\patient_ids_t_rest.csv\"\n",
    "N_WORKERS = 32\n",
    "\n",
    "def read_folder(args):\n",
    "    folder, files = args\n",
    "    rel = os.path.relpath(folder, ROOT)\n",
    "    batch = rel.split(os.sep)[0]\n",
    "    out = []\n",
    "    for f in files:\n",
    "        try:\n",
    "            ds = pydicom.dcmread(os.path.join(folder, f),\n",
    "                                 stop_before_pixels=True,\n",
    "                                 specific_tags=[\"PatientID\"],\n",
    "                                 force=True)\n",
    "            pid = str(ds.get(\"PatientID\", \"\")).strip()\n",
    "            out.append((pid if pid else \"NO ID\", batch, rel, f))\n",
    "        except Exception:\n",
    "            out.append((\"READ ERROR\", batch, rel, f))\n",
    "    return out\n",
    "\n",
    "# step 1: collect folders\n",
    "jobs = []\n",
    "for d, _, fs in tqdm(os.walk(ROOT), desc=\"Scanning folders\", unit=\" dir\"):\n",
    "    if fs:\n",
    "        jobs.append((d, fs))\n",
    "print(f\"Found {len(jobs)} folders with files\")\n",
    "\n",
    "# step 2: read EVERY file, print EVERY file's ID\n",
    "rows = []\n",
    "with ThreadPoolExecutor(N_WORKERS) as ex:\n",
    "    for i, results in enumerate(ex.map(read_folder, jobs), 1):\n",
    "        for pid, batch, rel, f in results:\n",
    "            rows.append((pid, batch, rel, f))\n",
    "            print(f\"[{i}/{len(jobs)}] {pid}  |  batch: {batch}  |  {rel}  |  {f}\", flush=True)\n",
    "\n",
    "with open(OUT_CSV, \"w\", newline=\"\") as fh:\n",
    "    w = csv.writer(fh)\n",
    "    w.writerow([\"patient_id\", \"batch\", \"folder\", \"file\"])\n",
    "    w.writerows(rows)\n",
    "\n",
    "print(f\"Done: {len(rows)} files -> {OUT_CSV}\")"
   ],
