   "source": [
    "import os, csv\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "import pydicom\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "ROOT = r\"F:\\raw\"\n",
    "OUT_CSV = r\"F:\\patient_ids.csv\"\n",
    "N_WORKERS = 32\n",
    "\n",
    "def read_folder(args):\n",
    "    folder, files = args\n",
    "    files = sorted(files, key=lambda f: not f.lower().endswith(\".dcm\"))\n",
    "    rel = os.path.relpath(folder, ROOT)\n",
    "    for f in files:\n",
    "        try:\n",
    "            ds = pydicom.dcmread(os.path.join(folder, f),\n",
    "                                 stop_before_pixels=True,\n",
    "                                 specific_tags=[\"PatientID\"],\n",
    "                                 force=True)\n",
    "            pid = str(ds.get(\"PatientID\", \"\")).strip()\n",
    "            if pid:\n",
    "                return (pid, rel.split(os.sep)[0], rel)\n",
    "        except Exception:\n",
    "            continue\n",
    "    return (None, rel.split(os.sep)[0], rel)\n",
    "\n",
    "# step 1: collect folders\n",
    "jobs = []\n",
    "for d, _, fs in tqdm(os.walk(ROOT), desc=\"Scanning folders\", unit=\" dir\"):\n",
    "    if fs:\n",
    "        jobs.append((d, fs))\n",
    "print(f\"Found {len(jobs)} folders with files\")\n",
    "\n",
    "# step 2: read one DICOM per folder in parallel, print every result\n",
    "rows = []\n",
    "with ThreadPoolExecutor(N_WORKERS) as ex:\n",
    "    for i, (pid, batch, rel) in enumerate(ex.map(read_folder, jobs), 1):\n",
    "        if pid:\n",
    "            rows.append((pid, batch, rel))\n",
    "            print(f\"[{i}/{len(jobs)}] {pid}  |  batch: {batch}  |  {rel}\", flush=True)\n",
    "        else:\n",
    "            print(f\"[{i}/{len(jobs)}] NO ID  |  batch: {batch}  |  {rel}\", flush=True)\n",
    "\n",
    "with open(OUT_CSV, \"w\", newline=\"\") as fh:\n",
    "    w = csv.writer(fh)\n",
    "    w.writerow([\"patient_id\", \"batch\", \"folder\"])\n",
    "    w.writerows(rows)\n",
    "\n",
    "print(f\"Done: {len(rows)} IDs -> {OUT_CSV}\")"
   ],
